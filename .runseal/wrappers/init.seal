__seal_argc=$#
__seal_help=false
force=false
check=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --force)
      force=true
      shift
      ;;
    --check)
      check=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -h|--help|help)
      __seal_help=true
      shift
      ;;
    *) fail "unknown option: $1" ;;
  esac
done

print() {
  printf '%s\n' "$1"
}

error() {
  printf '%s\n' "$1" >&2
}

fail() {
  error "$1"
  exit 1
}

usage() {
  print "Usage: runseal :init [--check] [--force]"
  print ""
  print "Validate the repository and install generated git hooks."
  print ""
  print "Options:"
  print "  --check    verify required tools, entrypoints, and hooks without writing files"
  print "  --force    back up custom hooks before replacing them"
}

require_tool() {
  exists=$(runseal @tool process exists "$1")
  if [ "$exists" = true ]; then
  else
    fail "init: missing required tool: $1"
  fi
}

require_path() {
  path="$root/$1"
  if [ -f "$path" ]; then
  else
    fail "init: missing required path: $1"
  fi
}

prepare_hook() {
  if [ -f "$1" ]; then
    generated=$(runseal @tool fs contains-any "$1" "mini-stim init hook" "mini-stim bootstrap hook")
    if [ "$generated" = true ]; then
    else
      if [ "$force" = true ]; then
        backup=$(runseal @tool fs backup-numbered "$1")
        print "backed up existing hook to $backup"
      else
        fail "init: $1 already exists and was not generated by runseal :init; rerun with --force to back it up and replace it"
      fi
    fi
  fi
}

install_hook() {
  source="$root/.runseal/hooks/$1"
  target="$hooks_dir/$1"
  prepare_hook "$target"
  cp "$source" "$target"
  runseal @tool fs chmod "$target" 755
  print "installed $target"
}

check_hook() {
  target="$hooks_dir/$1"
  if [ -f "$target" ]; then
  else
    fail "init: $target is missing; run runseal :init"
  fi
  generated=$(runseal @tool fs contains-any "$target" "mini-stim init hook" "mini-stim bootstrap hook")
  if [ "$generated" = true ]; then
    print "ok: $target"
  else
    fail "init: $target was not generated by runseal :init; rerun with --force to back it up and replace it"
  fi
}

if [ "$__seal_help" = true ]; then
  usage
  exit 0
fi

print "==> resolving repository"
root=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --absolute-git-dir)
hooks_dir="$git_dir/hooks"
print "repository: $root"

print "==> checking required tools"
require_tool git
require_tool cargo
require_tool pnpm
require_tool sidecar
require_tool flavor
require_tool runseal
require_tool sh
require_tool sed
require_tool grep
require_tool cp
print "ok: git, cargo, pnpm, sidecar, flavor, runseal, sh, sed, grep, cp"

print "==> checking repository entrypoints"
require_path AGENTS.md
require_path Cargo.toml
require_path Cargo.lock
require_path README.md
require_path .env.example
require_path .github/workflows/guard.yml
require_path flavor.toml
require_path package.json
require_path pnpm-lock.yaml
require_path pnpm-workspace.yaml
require_path runseal.toml
require_path proto/crates/transport/Cargo.toml
require_path proto/crates/server/Cargo.toml
require_path proto/crates/client/Cargo.toml
require_path apps/server/cell/Cargo.toml
require_path apps/server/soma/crates/santi-api/Cargo.toml
require_path apps/server/soma/crates/santi-core/Cargo.toml
require_path apps/server/soma/crates/santi-provider/Cargo.toml
require_path apps/client/cell/Cargo.toml
require_path apps/client/soma/Cargo.toml
require_path apps/client/soma/web/package.json
require_path packages/components/package.json
require_path packages/contracts/package.json
require_path .runseal/wrappers/codegen.seal
require_path .runseal/wrappers/browser.seal
require_path .runseal/wrappers/init.seal
require_path .runseal/wrappers/pr.seal
require_path .runseal/hooks/pre-commit
require_path .runseal/hooks/commit-msg
print "ok: repository entrypoints"

if [ "$check" = true ]; then
  print "==> checking git hooks"
  check_hook pre-commit
  check_hook commit-msg
else
  print "==> installing git hooks"
  runseal @tool fs mkdir "$hooks_dir" 700
  install_hook pre-commit
  install_hook commit-msg
fi

print "development environment ready"
